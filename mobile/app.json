{
  "expo": {
    "name": "CoachPro",
    "slug": "coach-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coachpro.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Serve per caricare le foto dei tuoi progressi.",
        "NSCameraUsageDescription": "Serve per scattare le foto dei tuoi progressi."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0f0f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.coachpro.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#c6f432"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Serve per caricare le foto dei tuoi progressi."
        }
      ]
    ],
    "scheme": "coachpro",
    "backgroundColor": "#0f0f0f",
    "experiments": {
      "typedRoutes": false
    }
  }
}